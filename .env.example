# Portion runs against the PayPal sandbox only. No real money.
# Leave PAYPAL_CLIENT_ID empty to run in preview mode: a local stand-in for PayPal
# that is labelled "preview" everywhere in the app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The address the app is served from. PayPal sends the payer back here after approval.
APP_URL=http://localhost:3000

# Currency for pay-ins and payouts.
CURRENCY=USD

# The AI agent writes plan proposals, payment checks and nudge wording.
# Leave empty to use the fixed preview rules, labelled "preview" in the app.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Spending ceiling for AI agent calls per UTC day. 0 turns the AI agent off.
AI_DAILY_CALL_LIMIT=60

# Where the SQLite file lives.
DATABASE_PATH=data/portion.sqlite
